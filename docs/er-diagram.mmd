erDiagram
    DEPARTMENT {
        uuid department_id PK  "Unique identifier for each department"
        varchar name  "Name of the department"
        timestamp created_at  "Record creation timestamp"
    }

    EMPLOYEE {
        uuid employee_id PK  "Unique identifier for employee"
        varchar first_name  "Employee first name"
        varchar last_name  "Employee last name"
        varchar address  "Employee residential address"
        date birthday  "Employee date of birth"
        varchar email UK  "Unique email for login/contact"
        varchar phone UK "Contact phone number"
        varchar password  "Hashed login password"
        varchar employment_type  "Full-time, Part-time, Contractor, etc."
        int contracted_hours  "Hours to be worked per week"
        date entry_date  "Employment start date"
        date exit_date  "Employment end date if applicable"
        date probation_end_date  "End of probation period"
        date contract_end_date  "Contract expiration date (if fixed term)"
        uuid department_id FK  "Links employee to a department"
        uuid role_id FK  "Defines employee role (Admin/HR/Manager/Employee)"
        boolean is_active  "Active status indicator"
        timestamp created_at  "Record creation timestamp"
    }

    ROLE {
        uuid role_id PK  "Unique identifier for role"
        varchar name  "Role name: Admin, HR, Manager, Employee"
        timestamp created_at  "Record creation timestamp"
    }

    TIME_ENTRY {
        uuid time_entry_id PK  "Unique time entry record identifier"
        uuid employee_id FK  "Employee associated with the time entry"
        time start_time  "Shift start time"
        time end_time  "Shift end time"
        float hours_worked  "Total hours worked"
        timestamp created_at  "Record creation timestamp"
    }

    ABSENCE {
        uuid absence_id PK  "Unique absence record identifier"
        uuid employee_id FK  "Employee requesting the leave"
        date start_date  "Absence start date"
        date end_date  "Absence end date"
        varchar type  "Leave type (Sick, Paid, Unpaid, etc.)"
        varchar reason  "Reason for leave"
        uuid approved_by FK  "Manager or HR who approved the leave"
        varchar status  "Leave status: Pending, Approved, Rejected"
        timestamp created_at  "Record creation timestamp"
    }

    TIME_ACCOUNT {
        uuid time_account_id PK  "Unique time account record identifier"
        uuid employee_id FK  "Linked employee"
        float balance  "Working hour balance (positive or negative)"
        timestamp created_at  "Record creation timestamp"
    }

    DEPARTMENT ||--o{ EMPLOYEE : has
    EMPLOYEE ||--|{ ROLE : has
    EMPLOYEE ||--o{ TIME_ENTRY : "records"
    EMPLOYEE ||--o{ ABSENCE : "has"
    EMPLOYEE ||--|{ TIME_ACCOUNT : "has"